# Firebase web app config (Project settings → General → Your apps).
# Leave these empty to run against the bundled CSV dataset instead.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Force the bundled dataset even when Firebase is configured.
VITE_USE_LOCAL_SERVICES=false

# Verbose service logging in the browser console.
VITE_DEBUG_MODE=false

# Only for `npm run enrich:images` (Firebase Admin service-account JSON path).
GOOGLE_APPLICATION_CREDENTIALS=
